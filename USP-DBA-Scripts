CREATE PROCEDURE dbo.usp_ShrinkDatabaseInChunks
(
    @DatabaseName SYSNAME,
    @FileName SYSNAME = NULL,
    @TargetSizeMB INT = NULL,
    @MinPercentFree INT = NULL,
    @IntervalMB INT = 300,
    @DelayBetweenShrinks VARCHAR(12) = '00:00:02',
    @WhatIf BIT = 0
)
AS
BEGIN
    SET NOCOUNT, XACT_ABORT, ARITHABORT ON;

    DECLARE @CurrSizeMB INT,
            @SpaceUsedMB INT,
            @NewSizeMB INT,
            @ShrinkStart DATETIME = GETDATE(),
            @ShrinkEnd DATETIME,
            @Status VARCHAR(20) = 'Pending',
            @Message NVARCHAR(2000) = '',
            @DBCCCommand NVARCHAR(MAX),
            @FileInfoSQL NVARCHAR(MAX);

    BEGIN TRY
        IF @DatabaseName IS NULL
            THROW 50000, 'Database name is required.', 1;

        IF @TargetSizeMB IS NULL AND @MinPercentFree IS NULL
            THROW 50001, 'Specify either @TargetSizeMB or @MinPercentFree.', 1;

        -- Get current file info dynamically
        SET @FileInfoSQL = N'
        USE ' + QUOTENAME(@DatabaseName) + ';
        SELECT TOP 1
            name AS FileName,
            size / 128 AS CurrSizeMB,
            CAST(FILEPROPERTY(name,''SpaceUsed'') AS INT)/128 AS SpaceUsedMB,
            CASE type WHEN 0 THEN ''DATA'' WHEN 1 THEN ''LOG'' ELSE ''OTHER'' END AS FileType
        FROM sys.database_files
        WHERE (@FileName IS NULL OR name=@FileName)
        ORDER BY size DESC;
        ';

        -- Use sp_executesql with OUTPUT parameters
        DECLARE @FileNameOut SYSNAME, @FileTypeOut VARCHAR(10);

        EXEC sp_executesql @FileInfoSQL,
            N'@FileName SYSNAME, @FileNameOut SYSNAME OUTPUT, @CurrSizeMBOut INT OUTPUT, @SpaceUsedMBOut INT OUTPUT, @FileTypeOut VARCHAR(10) OUTPUT',
            @FileName=@FileName,
            @FileNameOut=@FileNameOut OUTPUT,
            @CurrSizeMBOut=@CurrSizeMB OUTPUT,
            @SpaceUsedMBOut=@SpaceUsedMB OUTPUT,
            @FileTypeOut=@FileTypeOut OUTPUT;

        -- Determine target size
        IF @TargetSizeMB IS NULL
            SET @TargetSizeMB = CEILING(@SpaceUsedMB / (CAST(@MinPercentFree AS FLOAT)/100.0));

        IF @CurrSizeMB <= @TargetSizeMB
        BEGIN
            SET @Status='Skipped';
            SET @Message='Shrink not required.';
            GOTO LogAndExit;
        END

        -- Shrink loop
        WHILE @CurrSizeMB > @TargetSizeMB
        BEGIN
            SET @NewSizeMB = @CurrSizeMB - @IntervalMB;
            IF @NewSizeMB < @TargetSizeMB SET @NewSizeMB=@TargetSizeMB;

            SET @DBCCCommand = N'USE ' + QUOTENAME(@DatabaseName) + ';
                                DBCC SHRINKFILE (' + QUOTENAME(@FileName,'''') + ',' + CAST(@NewSizeMB AS NVARCHAR(10)) + ') WITH NO_INFOMSGS;';

            PRINT 'Shrinking from ' + CAST(@CurrSizeMB AS VARCHAR(10)) + ' MB → ' + CAST(@NewSizeMB AS VARCHAR(10)) + ' MB';

            IF @WhatIf = 0
                EXEC sp_executesql @DBCCCommand;
            ELSE
                PRINT '(WhatIf mode — skipped execution)';

            SET @CurrSizeMB=@NewSizeMB;

            IF @DelayBetweenShrinks IS NOT NULL
                WAITFOR DELAY @DelayBetweenShrinks;
        END

        SET @Status='Success';
        SET @Message='Shrink completed successfully.';

    END TRY
    BEGIN CATCH
        SET @Status='Failed';
        SET @Message=ERROR_MESSAGE();
    END CATCH

LogAndExit:
    SET @ShrinkEnd=GETDATE();

    -- Log everything dynamically to permanent table
    SET @FileInfoSQL = N'
    IF OBJECT_ID(''master.dbo.DBA_Shrink_Log'', ''U'') IS NULL
    BEGIN
        CREATE TABLE master.dbo.DBA_Shrink_Log
        (
            LogID INT IDENTITY(1,1) PRIMARY KEY,
            DatabaseName SYSNAME,
            FileName SYSNAME,
            FileType VARCHAR(10),
            OldSizeMB INT,
            NewSizeMB INT,
            DurationMin INT,
            StartTime DATETIME,
            EndTime DATETIME,
            ExecutedBy SYSNAME,
            Status VARCHAR(20),
            Message NVARCHAR(2000),
            CreatedOn DATETIME DEFAULT GETDATE()
        );
    END

    INSERT INTO master.dbo.DBA_Shrink_Log
    (DatabaseName, FileName, FileType, OldSizeMB, NewSizeMB, DurationMin, StartTime, EndTime, ExecutedBy, Status, Message)
    VALUES
    (''' + @DatabaseName + ''',''' + @FileName + ''',''' + ISNULL(@FileTypeOut,'OTHER') + ''',NULL,' + CAST(@CurrSizeMB AS NVARCHAR(10)) + ',' +
    CAST(DATEDIFF(MINUTE,@ShrinkStart,@ShrinkEnd) AS NVARCHAR(10)) + ',''' + CONVERT(NVARCHAR,@ShrinkStart,120) + ''',GETDATE(),ORIGINAL_LOGIN(),''' + @Status + ''',''' + @Message + ''');
    ';

    EXEC sp_executesql @FileInfoSQL;

    PRINT 'Shrink logged successfully.';
END


