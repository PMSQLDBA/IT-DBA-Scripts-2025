create proc BackupRestoreStatus
as
SELECT  
    r.session_id,
    r.command,
    db.name AS [DatabaseName],
    r.status,
    CONVERT(NUMERIC(6,2), r.percent_complete) AS [PercentComplete],
    CONVERT(VARCHAR(20), 
            DATEADD(SECOND, r.estimated_completion_time / 1000, GETDATE()), 
            120) AS [EstimatedCompletionTime],
    CONVERT(NUMERIC(10,2), r.estimated_completion_time / 1000.0 / 60.0) AS [ETA_Minutes],
    r.start_time AS [StartTime],
    DATEDIFF(MINUTE, r.start_time, GETDATE()) AS [Elapsed_Minutes],
    r.total_elapsed_time / 1000 AS [Elapsed_Seconds],
    r.wait_type,
    r.wait_time / 1000 AS [Wait_Sec],
    r.last_wait_type,
    r.cpu_time / 1000 AS [CPU_Sec],
    r.blocking_session_id,
    r.command AS [CommandType],
    t.text AS [TSQLCommand]
FROM  
    sys.dm_exec_requests r
INNER JOIN  
    sys.databases db ON r.database_id = db.database_id
CROSS APPLY  
    sys.dm_exec_sql_text(r.sql_handle) t
WHERE  
    r.command IN ('BACKUP DATABASE', 'BACKUP LOG', 'RESTORE DATABASE', 'RESTORE LOG')
ORDER BY  
    r.percent_complete DESC;

